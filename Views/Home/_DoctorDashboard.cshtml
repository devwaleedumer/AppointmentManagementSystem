@using AppointmentManagementSystem.Views.Home
@model DoctorDashboardViewModel
<section class="py-4">

    <div class="mb-4">
        <h3 class="fw-bold mb-1">Doctor Dashboard</h3>
        <p class="text-muted mb-0">Manage your appointments and patient requests.</p>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Total Appointments</p>
                        <h3 class="fw-bold mb-0">@Model.TotalAppointments</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="Index" asp-route-filter="today" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Today's Appointments</p>
                        <h3 class="fw-bold mb-0">@Model.TodaysAppointments</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="Index" asp-route-filter="pending" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Pending</p>
                        <h3 class="fw-bold mb-0">@Model.PendingAppointments</h3>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-controller="Appointment" asp-action="Index" asp-route-filter="approved" class="text-decoration-none text-dark">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-muted mb-1">Approved</p>
                        <h3 class="fw-bold mb-0">@Model.ApprovedAppointments</h3>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between">
            <h5 class="mb-0 fw-bold">Recent Appointments</h5>

            <a asp-controller="Appointment"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">
                View All
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Patient</th>
                            <th>Start Date</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.RecentAppointments.Any())
                        {
                            foreach (var appointment in Model.RecentAppointments)
                            {
                                <tr>
                                    <td>@appointment.Title</td>
                                    <td>@appointment.PatientName</td>
                                    <td>@appointment.StartDate</td>
                                    <td>@appointment.Duration min</td>
                                    <td>
                                        @if (appointment.IsDoctorApproved == 1)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (appointment.IsDoctorApproved == 0)
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (appointment.IsDoctorApproved == -1)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unknown</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No recent appointments found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</section>