@{
    ViewData["Title"] = "Email Verification";
    bool isValid = ViewBag.IsValid ?? false;
    string message = ViewBag.Message ?? "";
}

<div class="vh-100 d-flex justify-content-center align-items-center bg-light">

    <div class="card shadow border-0" style="width: 450px;">

        <div class="card-body text-center p-5">

            @if (isValid)
            {
                <div class="mb-4">
                    <div class="rounded-circle bg-success d-inline-flex justify-content-center align-items-center"
                         style="width:80px;height:80px;">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="40"
                             height="40"
                             fill="white"
                             class="bi bi-check-lg"
                             viewBox="0 0 16 16">
                            <path d="M13.485 1.929a.75.75 0 0 1 .086 1.057l-7 8a.75.75 0 0 1-1.08.02l-3-3.2a.75.75 0 1 1 1.098-1.02l2.435 2.598 6.457-7.38a.75.75 0 0 1 1.057-.075z" />
                        </svg>

                    </div>
                </div>

                <h2 class="text-success">Success</h2>

                <p class="text-muted mt-3">
                    @message
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-success mt-3 px-4">
                    Go To Login
                </a>
            }
            else
            {
                <div class="mb-4">
                    <div class="rounded-circle bg-danger d-inline-flex justify-content-center align-items-center"
                         style="width:80px;height:80px;">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="40"
                             height="40"
                             fill="white"
                             class="bi bi-x-lg"
                             viewBox="0 0 16 16">
                            <path d="M2.146 2.146a.5.5 0 0 1 .708 0L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 1 1-.708-.708L7.293 8 2.146 2.854a.5.5 0 0 1 0-.708" />
                        </svg>

                    </div>
                </div>

                <h2 class="text-danger">Verification Failed</h2>

                <p class="text-muted mt-3">
                    @message
                </p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-danger mt-3 px-4">
                    Back To Login
                </a>
            }

        </div>
    </div>

</div>