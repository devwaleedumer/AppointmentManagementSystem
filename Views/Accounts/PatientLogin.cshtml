@using AppointmentManagementSystem.ViewModels.Accounts
@model PatientLoginViewModel

@{
    ViewData["Title"] = "Patient Login";
}
@Model.
<div class="vh-100 d-flex justify-content-center align-items-center bg-light">
    <div class="card shadow border-0" style="width: 400px;">

        <div class="card-header bg-white border-0 text-center pt-4">
            <div class="rounded-circle text-bg-info mx-auto d-flex justify-content-center align-items-center"
                style="width: 70px; height: 70px;">

                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="white" class="bi bi-person"
                    viewBox="0 0 16 16">
                    <path
                        d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                </svg>
            </div>

            <h3 class="mt-3 mb-0">Patient Login</h3>
            <p class="text-muted small">Login to your patient account</p>
        </div>

        <div class="card-body px-4 pb-4">

            <form asp-action="PatientLogin" asp-controller="Accounts" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.ErrorMessage
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email" type="text" class="form-control" placeholder="Enter your email" />

                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>

                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />

                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Login as Patient
                </button>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}