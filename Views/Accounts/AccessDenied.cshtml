@{
    ViewData["Title"] = "Access Denied";
}

<div class="vh-100 d-flex justify-content-center align-items-center bg-light">
    <div class="card shadow border-0 text-center" style="max-width: 480px;">
        <div class="card-body p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-lock" style="font-size: 3rem;"></i>
            </div>
            <h2 class="mb-3">Access Denied</h2>
            <p class="text-muted mb-4">
                You are signed in, but your account does not have permission to view this page.
            </p>
            <div class="d-grid gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    Go to Dashboard
                </a>
                <form asp-controller="Accounts" asp-action="Logout" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        Sign out and use another account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
